      "path": "/",
      "expectSelector": "[data-mode='utbk']"
    },
    {
      "name": "Dashboard logo",
      "path": "/",
      "expectSelector": ".brand-logo"
    },
    {
      "name": "Profile role badge",
      "path": "/",
      "expectText": "Pejuang"
    },
    {
      "id": "demo",
      "name": "Populated demo",
      "path": "/?demo=1",
      "expectText": "Staging demo",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "name": "Quiz screen",
      "path": "/ujian/cpns",
      "expectSelector": ".rail-tile"
    },
    {
      "name": "Tanya AI button on the dashboard",
      "path": "/",
      "expectSelector": "[data-ai-launch]"
    },
    {
      "id": "tanya-ai.chat",
      "name": "Tanya AI chat",
      "path": "/tanya-ai",
      "expectText": "Jelaskan jawaban ini",
      "visual": true,
      "impact": [
        "ai.js",
        "ai-content.js",
        "server.js",
        "public/app.js",
        "public/screens.css",
        "public/index.html"
      ]
    },
    {
      "name": "Tanya AI with a question in context",
      "path": "/tanya-ai?q=utbk-1",
      "expectText": "Penalaran Matematika"
    },
    {
      "name": "Saved explanations",
      "path": "/tanya-ai/riwayat",
      "expectText": "Belum ada percakapan tersimpan"
    },
    {
      "name": "UTBK exam navigator",
      "path": "/ujian/utbk",
      "expectText": "Ragu-ragu"
    },
    {
      "name": "Daily practice",
      "path": "/ujian/harian",
      "expectSelector": ".rail-tile"
    },
    {
      "name": "Dashboard daily card",
      "path": "/",
      "expectText": "Latihan harian"
    },
    {
      "name": "Progress",
      "path": "/progres?demo=1",
      "expectText": "Subtes terlemah",
      "visual": true,
      "impact": [
        "public/**"
      ]
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
